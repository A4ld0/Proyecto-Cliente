{
  "$schema": "https://supabase.com/schemas/config/v1.json",
  "project_id": "supabase-testbed",
  "api": {
    "enabled": true,
    "port": 54321,
    "schemas": ["public", "graphql_public"],
    "extra_search_path": ["public", "extensions"],
    "max_rows": 1000
  },
  "db": {
    "port": 54322,
    "shadow_port": 54320,
    "major_version": 17,
    "seed": { "enabled": false }
  },
  "auth": {
    "enabled": true,
    "site_url": "http://127.0.0.1:4307",
    "additional_redirect_urls": ["http://127.0.0.1:4307/auth/callback"],
    "enable_signup": true,
    "email": { "enabled": true, "enable_confirmations": false }
  },
  "realtime": { "enabled": true },
  "storage": { "enabled": true, "file_size_limit": "50MiB" },
  "studio": { "enabled": false },
  "edge_runtime": { "enabled": false },
  "analytics": { "enabled": false }
}
